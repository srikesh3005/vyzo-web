# ============================================================
# Vyzo — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ============================================================

# ─── Next.js ────────────────────────────────────────────────────────────────
# The URL of this API (used by the frontend API client)
# For local development: leave empty or set to http://localhost:3000
API_URL=

# ─── Firebase (Backend/Admin) ──────────────────────────────────────────────────
# Get this from your Firebase console: Project Settings → Service Accounts → Generate new private key
# Copy the entire contents of the downloaded JSON file and minute it as a single string
FIREBASE_SERVICE_ACCOUNT_KEY='{ "type": "service_account", "project_id": "...", ... }'

# ─── Firebase (Client-side) ──────────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=your-very-long-random-secret-here-minimum-64-characters
JWT_REFRESH_SECRET=another-very-long-random-secret-different-from-above

# ─── Amazon PA-API (Optional — falls back to mock if not set) ─────────────────
# Register at: https://affiliate-program.amazon.in/
# Get PA-API keys from: https://webservices.amazon.in/paapi5/documentation/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=vyzoai-21

# Set to true to use mock data instead of real PA-API
# Recommended during development when you don't have PA-API access yet
AMAZON_USE_MOCK=true

# ─── AI Provider (Optional — summaries disabled if not set) ──────────────────
# Gemini (recommended — free tier available)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OR OpenAI (used as fallback if GEMINI_API_KEY is not set)
OPENAI_API_KEY=

# ─── App Configuration ───────────────────────────────────────────────────────
APP_VERSION=1.0.0
LOG_LEVEL=info   # debug | info | warn | error

# ─── Optional: Redis (for production rate limiting) ──────────────────────────
# If not set, in-memory rate limiting is used (single-instance only)
# REDIS_URL=redis://localhost:6379
